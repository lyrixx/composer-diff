{
    "name": "lyrixx/composer-diff",
    "description": "Compare what changed in your composer.lock",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Grégoire Pineau",
            "email": "lyrixx@lyrixx.info"
        }
    ],
    "require": {
        "composer/composer": "^2.10.3",
        "ion-bazan/composer-diff": "^2.4",
        "symfony/twig-bridge": "^8.1.7",
        "symfony/var-dumper": "^8.1.9",
        "twig/twig": "^3.30"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "ion-bazan/composer-diff": false
        },
        "bump-after-update": true,
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.11"
        }
    }
}
